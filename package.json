{
  "name": "ai-chat-formatter",
  "version": "0.4.0",
  "private": true,
  "description": "Chrome extension that copies LLM chat replies as clean Markdown, with their citations.",
  "author": "Corey Struzan",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "watch": "node scripts/build.mjs --dev --watch",
    "test": "node scripts/run-tests.mjs",
    "package": "pnpm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/turndown": "^5.0.6",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2"
  }
}
